__pycache__/
.pytest_cache/
*.pyc
*.pyo
.venv/
.pip-cache/
.uv-cache/
.tmp/

# Runtime data -- anchored to the project root with a leading slash on purpose.
# An unanchored "models/" would also match livetranslate/models/, silently
# dropping the model-manager *code package* from every commit.
/models/
/logs/
/docs/
/transcripts/
# Runtime settings, plus any .bak-* copy taken before editing them by hand.
/user_settings.json*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Agent tooling state (workspace memory, etc.)
.workbuddy/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Distribution
dist/
build/
release/
*.egg-info/

# The packaged exe is built into the project root so it reuses the existing
# config.yaml / user_settings.json / models/ -- do not commit the binary.
/LiveTranslate.exe
/LiveTranslate.prev-*
